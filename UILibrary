                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, 16),
                    BackgroundColor3 = colors.elem
                })
                c("UICorner", {Parent = bg, CornerRadius = UDim.new(0, 4)})
                local stroke = c("UIStroke", {Parent = bg, Color = colors.line, Thickness = 1})

                local input = c("TextBox", {
                    Parent = bg,
                    Size = UDim2.new(1, -12, 1, 0),
                    Position = UDim2.new(0, 6, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    PlaceholderText = bPlaceholder,
                    TextColor3 = colors.txt,
                    PlaceholderColor3 = colors.sub,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false
                })

                input.Focused:Connect(function()
                    tw:Create(stroke, TweenInfo.new(0.2), {Color = colors.accent}):Play()
                end)
                input.FocusLost:Connect(function(ep)
                    tw:Create(stroke, TweenInfo.new(0.2), {Color = colors.line}):Play()
                    if ep then
                        cb(input.Text)
                        if bArgs.ClearOnFocusLost then input.Text = "" end
                    end
                end)
            end

            function s:btn(bArgs)
                bArgs = bArgs or {}
                local bTxt = bArgs.Name or "Button"
                local cb = bArgs.Callback or function() end
                local isPrem = string.find(string.upper(bTxt), "PREMIUM") ~= nil
                local txtCol = isPrem and colors.goldc or colors.sub
                local oldCb = cb
                cb = function(...)
                    if isPrem and not _G.ownsPremiumLoader then
                        lib:ShowPremiumPopup()
                        return
                    end
                    return oldCb(...)
                end

                local b = c("TextButton", {
                    Parent = sec,
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = colors.elem,
                    Text = bTxt,
                    TextColor3 = txtCol,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    AutoButtonColor = false
                })
                c("UICorner", {Parent = b, CornerRadius = UDim.new(0, 4)})
                c("UIStroke", {Parent = b, Color = colors.line, Thickness = 1})

                b.MouseEnter:Connect(function() tw:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = colors.elemh}):Play() end)
                b.MouseLeave:Connect(function() tw:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = colors.elem}):Play() end)
                b.MouseButton1Down:Connect(function() tw:Create(b, TweenInfo.new(0.1), {Size = UDim2.new(1, -4, 0, 28)}):Play() end)
                b.MouseButton1Up:Connect(function()
                    tw:Create(b, TweenInfo.new(0.1), {Size = UDim2.new(1, 0, 0, 32)}):Play()
                    cb()
                end)
            end

            function s:bind(bArgs)
                bArgs = bArgs or {}
                local bTxt = bArgs.Name or "Keybind"
                local def = bArgs.Default or Enum.KeyCode.E
                local cb = bArgs.Callback or function() end
                
                local currentKey = def
                local binding = false

                local b = c("TextButton", {
                    Parent = sec,
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = colors.elem,
                    Text = bTxt .. ": " .. currentKey.Name,
                    TextColor3 = colors.sub,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    AutoButtonColor = false
                })
                c("UICorner", {Parent = b, CornerRadius = UDim.new(0, 4)})
                c("UIStroke", {Parent = b, Color = colors.line, Thickness = 1})

                b.MouseEnter:Connect(function() tw:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = colors.elemh}):Play() end)
                b.MouseLeave:Connect(function() tw:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = colors.elem}):Play() end)
                b.MouseButton1Down:Connect(function() tw:Create(b, TweenInfo.new(0.1), {Size = UDim2.new(1, -4, 0, 28)}):Play() end)
                b.MouseButton1Up:Connect(function()
                    tw:Create(b, TweenInfo.new(0.1), {Size = UDim2.new(1, 0, 0, 32)}):Play()
                    binding = true
                    b.Text = bTxt .. ": ..."
                end)

                uis.InputBegan:Connect(function(inp)
                    if binding then
                        if inp.UserInputType == Enum.UserInputType.Keyboard then
                            binding = false
                            currentKey = inp.KeyCode
                            b.Text = bTxt .. ": " .. currentKey.Name
                            cb(currentKey)
                        elseif string.find(inp.UserInputType.Name, "MouseButton") then
                            binding = false
                            currentKey = inp.UserInputType
                            b.Text = bTxt .. ": " .. currentKey.Name
                            cb(currentKey)
                        end
                    end
                end)
            end

            function s:tog(tArgs)
                tArgs = tArgs or {}
                local tTxt = tArgs.Name or "Toggle"
                local def = tArgs.Default or false
                local cb = tArgs.Callback or function() end
                local isPrem = string.find(string.upper(tTxt), "PREMIUM") ~= nil
                local txtCol = isPrem and colors.goldc or colors.sub
                local oldCb = cb
                local state
                local up
                cb = function(...)
                    if isPrem and not _G.ownsPremiumLoader then
                        -- flip state back visually if it was changed
                        state = not state
                        up(true)
                        lib:ShowPremiumPopup()
                        return
                    end
                    return oldCb(...)
                end
                
                local f = c("Frame", {
                    Parent = sec,
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = colors.elem,
                    BorderSizePixel = 0
                })
                c("UICorner", {Parent = f, CornerRadius = UDim.new(0, 4)})
                c("UIStroke", {Parent = f, Color = colors.line, Thickness = 1})

                c("TextLabel", {
                    Parent = f,
                    Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(1, -60, 1, 0),
                    BackgroundTransparency = 1,
                    Text = tTxt,
                    TextColor3 = txtCol,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local ind = c("Frame", {
                    Parent = f,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -12, 0.5, 0),
                    Size = UDim2.fromOffset(36, 18),
                    BackgroundColor3 = colors.bg
                })
                c("UICorner", {Parent = ind, CornerRadius = UDim.new(1, 0)})
                c("UIStroke", {Parent = ind, Color = colors.line, Thickness = 1})

                local circ = c("Frame", {
                    Parent = ind,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 2, 0.5, 0),
                    Size = UDim2.fromOffset(14, 14),
                    BackgroundColor3 = colors.sub
                })
                c("UICorner", {Parent = circ, CornerRadius = UDim.new(1, 0)})

                local tBtn = c("TextButton", {
                    Parent = f,
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    Text = ""
                })

                state = def
                
                up = function(anim)
                    local pos = state and UDim2.new(0, 20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
                    local col = state and colors.goldc or colors.sub
                    if anim then
                        tw:Create(circ, TweenInfo.new(0.2), {Position = pos, BackgroundColor3 = col}):Play()
                    else
                        circ.Position = pos
                        circ.BackgroundColor3 = col
                    end
                end
                up(false)

                tBtn.MouseButton1Click:Connect(function()
                    state = not state
                    up(true)
                    cb(state)
                end)
            end

            function s:sldr(slArgs)
                slArgs = slArgs or {}
                local slTxt = slArgs.Name or "Slider"
                local min = slArgs.Min or 0
                local max = slArgs.Max or 100
                local def = slArgs.Default or min
                local cb = slArgs.Callback or function() end
                local isPrem = string.find(string.upper(slTxt), "PREMIUM") ~= nil
                local txtCol = isPrem and colors.goldc or colors.sub
                local oldCb = cb
                cb = function(...)
                    if isPrem and not _G.ownsPremiumLoader then
                        lib:ShowPremiumPopup()
                        return
                    end
                    return oldCb(...)
                end

                local f = c("Frame", {
                    Parent = sec,
                    Size = UDim2.new(1, 0, 0, 46),
                    BackgroundColor3 = colors.elem,
                    BorderSizePixel = 0
                })
                c("UICorner", {Parent = f, CornerRadius = UDim.new(0, 4)})
                c("UIStroke", {Parent = f, Color = colors.line, Thickness = 1})

                c("TextLabel", {
                    Parent = f,
                    Position = UDim2.fromOffset(12, 6),
                    Size = UDim2.new(1, -24, 0, 14),
                    BackgroundTransparency = 1,
                    Text = slTxt,
                    TextColor3 = txtCol,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                local val = c("TextLabel", {
                    Parent = f,
                    Position = UDim2.fromOffset(12, 6),
                    Size = UDim2.new(1, -24, 0, 14),
                    BackgroundTransparency = 1,
                    Text = tostring(def),
                    TextColor3 = txtCol,
                    Font = Enum.Font.Gotham,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Right
                })

                local trk = c("Frame", {
                    Parent = f,
                    Position = UDim2.new(0, 12, 1, -14),
                    Size = UDim2.new(1, -24, 0, 4),
                    BackgroundColor3 = colors.bg,
                    BorderSizePixel = 0
                })
                c("UICorner", {Parent = trk, CornerRadius = UDim.new(1, 0)})

                local fill = c("Frame", {
                    Parent = trk,
                    Size = UDim2.fromScale(0, 1),
                    BackgroundColor3 = colors.goldc,
                    BorderSizePixel = 0
                })
                c("UICorner", {Parent = fill, CornerRadius = UDim.new(1, 0)})

                local sBtn = c("TextButton", {
                    Parent = trk,
                    Size = UDim2.new(1, 0, 1, 16),
                    Position = UDim2.fromOffset(0, -8),
                    BackgroundTransparency = 1,
                    Text = ""
                })

                local function set(v)
                    v = math.clamp(math.floor(v + 0.5), min, max)
                    val.Text = tostring(v)
                    local pct = (v - min) / (max - min)
                    tw:Create(fill, TweenInfo.new(0.1), {Size = UDim2.fromScale(pct, 1)}):Play()
                    cb(v)
                end
                
                local drg = false
                sBtn.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        drg = true
                        local pct = math.clamp((inp.Position.X - trk.AbsolutePosition.X) / trk.AbsoluteSize.X, 0, 1)
                        set(min + (max - min) * pct)
                    end
                end)

                uis.InputChanged:Connect(function(inp)
                    if drg and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        local pct = math.clamp((inp.Position.X - trk.AbsolutePosition.X) / trk.AbsoluteSize.X, 0, 1)
                        set(min + (max - min) * pct)
                    end
                end)

                uis.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        drg = false
                    end
                end)
                
                set(def)
            end

            
            function s:para(pArgs)
                pArgs = pArgs or {}
                local title = pArgs.Title or ""
                local text = pArgs.Text or ""
                local fullStr = title .. "\n" .. text
                if title == "" then fullStr = text end

                local lbl = c("TextLabel", {
                    Parent = sec,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Text = fullStr,
                    TextColor3 = colors.sub,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                return {
                    Set = function(self, newArgs)
                        local t = newArgs.Title or ""
                        local txt = newArgs.Text or ""
                        local fs = t .. "\n" .. txt
                        if t == "" then fs = txt end
                        lbl.Text = fs
                    end,
                    Instance = lbl
                }
            end

            function s:lbl(lTxt)
                c("TextLabel", {
                    Parent = sec,
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Text = lTxt,
                    TextColor3 = colors.sub,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
            end
            
            function s:drop(dArgs)
                dArgs = dArgs or {}
                local dTxt = dArgs.Name or "Dropdown"
                local options = dArgs.Options or {}
                local default = dArgs.Default or ""
                local cb = dArgs.Callback or function() end
                local isPrem = string.find(string.upper(dTxt), "PREMIUM") ~= nil
                local txtCol = isPrem and colors.goldc or colors.txt
                local oldCb = cb
                cb = function(...)
                    if isPrem and not _G.ownsPremiumLoader then
                        lib:ShowPremiumPopup()
                        return
                    end
                    return oldCb(...)
                end
                
                local dropApi = {}
                
                local f = c("Frame", {
                    Parent = sec,
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundColor3 = colors.elem,
                    BorderSizePixel = 0,
                    ClipsDescendants = true
                })
                c("UICorner", {Parent = f, CornerRadius = UDim.new(0, 4)})
                c("UIStroke", {Parent = f, Color = colors.line, Thickness = 1})
                
                local btn = c("TextButton", {
                    Parent = f,
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                    Text = ""
                })
                
                c("TextLabel", {
                    Parent = f,
                    Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(1, -24, 0, 32),
                    BackgroundTransparency = 1,
                    Text = dTxt .. " - " .. tostring(default),
                    TextColor3 = txtCol,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextXAlignment = Enum.TextXAlignment.Left
                })
                
                local listFrame = c("Frame", {
                    Parent = f,
                    Position = UDim2.fromOffset(0, 32),
                    Size = UDim2.new(1, 0, 1, -32),
                    BackgroundTransparency = 1
                })
                
                local lyt = c("UIListLayout", {
                    Parent = listFrame,
                    SortOrder = Enum.SortOrder.LayoutOrder
                })
                
                local expanded = false
                
                function dropApi:Refresh(newOpts)
                    options = newOpts or {}
                    for _, v in pairs(listFrame:GetChildren()) do
                        if v:IsA("TextButton") then v:Destroy() end
                    end
                    
                    local h = 32
                    for i, opt in ipairs(options) do
                        local oBtn = c("TextButton", {
                            Parent = listFrame,
                            Size = UDim2.new(1, 0, 0, 24),
                            BackgroundColor3 = colors.elem,
                            Text = tostring(opt),
                            TextColor3 = txtCol,
                            Font = Enum.Font.Gotham,
                            TextSize = 11,
                            AutoButtonColor = false,
                            LayoutOrder = i
                        })
                        
                        oBtn.MouseEnter:Connect(function() tw:Create(oBtn, TweenInfo.new(0.15), {TextColor3 = txtCol, BackgroundColor3 = colors.elemh}):Play() end)
                        oBtn.MouseLeave:Connect(function() tw:Create(oBtn, TweenInfo.new(0.15), {TextColor3 = txtCol, BackgroundColor3 = colors.elem}):Play() end)
                        
                        oBtn.MouseButton1Click:Connect(function()
                            expanded = false
                            tw:Create(f, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 32)}):Play()
                            f.TextLabel.Text = dTxt .. " - " .. tostring(opt)
                            cb(opt)
                        end)
                        h = h + 24
                    end
                    
                    if expanded then
                        tw:Create(f, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, h)}):Play()
                    end
                end
                
                btn.MouseButton1Click:Connect(function()
                    expanded = not expanded
                    if expanded then
                        local h = 32 + (#options * 24)
                        tw:Create(f, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, h)}):Play()
                    else
                        tw:Create(f, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 32)}):Play()
                    end
                end)
                
                dropApi:Refresh(options)
                if default ~= nil and default ~= "" then
                    cb(default)
                end
                
                return dropApi
            end

            return s
        end

        return t
    end

    return win
end

return lib
